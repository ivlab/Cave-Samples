    fileName: RunCave.bat
    fileText: "@REM Server \nSTART {exeName} -vrconfig \"VRConfig_UMNCave_Server_LeftWall\"
      -logFile .\\umncave-server-leftwall.log \n\n@REM Three Clients \nTIMEOUT /t
      6 \nSTART {exeName} -vrconfig \"VRConfig_UMNCave_Client_FrontWall\" -logFile
      .\\umncave-client-frontwall.log \nTIMEOUT /t 3 \nSTART {exeName} -vrconfig
      \"VRConfig_UMNCave_Client_RightWall\" -logFile .\\umncave-client-rightwall.log
      \nTIMEOUT /t 3 \nSTART {exeName} -vrconfig \"VRConfig_UMNCave_Client_Floor\"
      -logFile .\\umncave-client-floor.log \n"
    copyLocation: 0
